+    @testset verbose=true "Load Balancing Does Not Change the Right-Hand Side" begin
+        initial_condition = rectangular_patch(0.1, (21, 21), perturbation_factor=0.0)
+        fluid_system = EntropicallyDampedSPHSystem(initial_condition; smoothing_kernel,
+                                                   smoothing_length=0.12,
+                                                   sound_speed=10.0,
+                                                   particle_refinement=refinement,
+                                                   buffer_size=50)
+        # The default update strategy doesn't support the inactive particles of the buffer
+        neighborhood_search = GridNeighborhoodSearch{2}(update_strategy=SerialUpdate())
+        semi = Semidiscretization(fluid_system; neighborhood_search,
+                                  parallelization_backend=PolyesterBackend())
+        ode = semidiscretize(semi, (0.0, 0.1))
+        system = ode.p.semi.systems[1]
+        v_ode, u_ode = ode.u0.x
+
+        @test system.buffer.thread_block[] == TrixiParticles.thread_block_refinement(refinement)
+
+        # Fine particles on one side, and a velocity and pressure field
+        u = TrixiParticles.wrap_u(u_ode, system, ode.p.semi)
+        v = TrixiParticles.wrap_v(v_ode, system, ode.p.semi)
+        for particle in TrixiParticles.each_active_particle(system)
+            x = u[1, particle]
+            y = u[2, particle]
+            if x > 0
+                TrixiParticles.set_particle_smoothing_length!(system, particle, 0.06)
+            end
+            v[1, particle] = sin(7 * x) * cos(5 * y)
+            v[2, particle] = cos(3 * x) * y
+            v[3, particle] = 100 * sin(4 * x + 3 * y)
+        end
+
+        function dv_with_block(block)
+            TrixiParticles.set_thread_block!(system.buffer, block)
+            dv_ode = zero(v_ode)
+            TrixiParticles.kick!(dv_ode, v_ode, u_ode, ode.p, 0.0)
+
+            return copy(parent(dv_ode))
+        end
+
+        dv_plain = dv_with_block(0)
+        @test any(!iszero, dv_plain)
+        # Each particle only writes its own `dv`, so the results are identical
+        @test dv_with_block(4) == dv_plain
+        @test dv_with_block(64) == dv_plain
+    end
 end
