+
+# ==== Load balancing of the threaded neighbor loops
+# `@threaded` gives each thread an equal contiguous share of the points. With refinement,
+# the split particles are put into the inactive slots at the end of the buffer, so the
+# last threads get most of the fine particles, which have the most neighbor candidates.
+# Dealing blocks of `thread_block` active particles to the threads in turn spreads them.
+# Each iteration of these loops only writes to its own particle, so the order doesn't
+# change the results.
+update_thread_order!(buffer::SystemBuffer) = update_thread_order!(buffer,
+                                                                  buffer.thread_order)
+
+update_thread_order!(buffer, ::Nothing) = buffer
+
+function update_thread_order!(buffer, thread_order)
+    (; eachparticle) = buffer
+    block = buffer.thread_block[]
+    block > 0 || return buffer
+
+    n = buffer.active_particle_count[]
+    n_threads = Threads.nthreads()
+    n_blocks = cld(n, block)
+
+    # Thread `k` (in the contiguous shares of `@threaded`) gets the blocks
+    # `k`, `k + n_threads`, `k + 2 n_threads`, ...
+    i = 0
+    for k in 1:n_threads, b in k:n_threads:n_blocks
+        for j in ((b - 1) * block + 1):min(b * block, n)
+            i += 1
+            @inbounds thread_order[i] = eachparticle[j]
+        end
+    end
+
     return buffer
 end
 
+# Change the block size of the load balancing at runtime (0 switches it off).
+# Only possible for a buffer that was created with `thread_block > 0`.
+function set_thread_block!(buffer::SystemBuffer, block)
+    isnothing(buffer.thread_order) &&
+        throw(ArgumentError("this buffer was created without load balancing"))
+
+    buffer.thread_block[] = block
+
+    return update_thread_order!(buffer)
+end
+
+# The points of a threaded neighbor loop of `system`: the balanced order of the buffer
+# when the loop is over all active particles, otherwise `points`
+@inline function thread_balanced_points(system, points, parallelization_backend)
+    return thread_balanced_points(buffer(system), points, parallelization_backend)
+end
+
+@inline thread_balanced_points(::Nothing, points, parallelization_backend) = points
+
+@inline function thread_balanced_points(buffer::SystemBuffer, points,
+                                        parallelization_backend)
+    return thread_balanced_points(buffer, buffer.thread_order, points,
+                                  parallelization_backend)
+end
+
+@inline function thread_balanced_points(buffer, ::Nothing, points, parallelization_backend)
+    return points
+end
+
+@inline function thread_balanced_points(buffer, thread_order, points,
+                                        parallelization_backend)
+    return points
+end
+
+# `each_active_particle(system, buffer)` is this view of `eachparticle`
+@inline function thread_balanced_points(buffer, thread_order::AbstractVector,
+                                        points::SubArray, parallelization_backend)
+    n = buffer.active_particle_count[]
+    if buffer.thread_block[] > 0 && !(parallelization_backend isa SerialBackend) &&
+       parent(points) === buffer.eachparticle && parentindices(points) == (1:n,)
+        return view(thread_order, 1:n)
+    end
+
+    return points
+end
