diff --git a/test/general/buffer.jl b/test/general/buffer.jl
index 7a3c254..00483d1 100644
--- a/test/general/buffer.jl
+++ b/test/general/buffer.jl
@@ -86,4 +86,51 @@
             @test_throws ArgumentError(error_str) TrixiParticles.allocate_buffer(ic, buffer)
         end
     end
+
+    @testset verbose=true "Load Balancing" begin
+        active(buffer) = collect(TrixiParticles.each_active_particle(nothing, buffer))
+        function balanced(buffer, backend=PolyesterBackend())
+            points = TrixiParticles.each_active_particle(nothing, buffer)
+            return collect(TrixiParticles.thread_balanced_points(buffer, points, backend))
+        end
+
+        buffer = TrixiParticles.SystemBuffer(300, 100; thread_block=4)
+        n_threads = Threads.nthreads()
+
+        @testset "Blocks Are Dealt to the Threads" begin
+            @test sort(balanced(buffer)) == active(buffer)
+            @test balanced(buffer)[1:4] == 1:4
+            # The first thread continues with the block after those of the other threads
+            @test balanced(buffer)[5:8] == (4 * n_threads + 1):(4 * n_threads + 4)
+        end
+
+        @testset "Order Follows the Active Particles" begin
+            buffer.active_particle[1:2:end] .= false
+            buffer.active_particle[350] = true
+            TrixiParticles.update_system_buffer!(buffer)
+            @test sort(balanced(buffer)) == active(buffer)
+
+            TrixiParticles.resize_buffer!(buffer, 500)
+            @test length(buffer.thread_order) == 500
+            @test sort(balanced(buffer)) == active(buffer)
+        end
+
+        @testset "Only Parallel Loops Over All Active Particles" begin
+            @test balanced(buffer, SerialBackend()) == active(buffer)
+
+            subset = view(buffer.eachparticle, 1:10)
+            @test TrixiParticles.thread_balanced_points(buffer, subset,
+                                                        PolyesterBackend()) === subset
+        end
+
+        @testset "Switched Off" begin
+            TrixiParticles.set_thread_block!(buffer, 0)
+            @test balanced(buffer) == active(buffer)
+
+            plain = TrixiParticles.SystemBuffer(5, 5)
+            @test isnothing(plain.thread_order)
+            @test balanced(plain) == active(plain)
+            @test_throws ArgumentError TrixiParticles.set_thread_block!(plain, 4)
+        end
+    end
 end
